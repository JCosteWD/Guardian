<?xml version="1.0" encoding="utf-8"?>
<!--
  GUARDIAN – Configuration du service d'accessibilité
  =====================================================
  Déclare les événements que Guardian surveille.
  typeAllMask = surveille TOUS les événements de fenêtre pour détecter
  quelle app est au premier plan et réagir immédiatement.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackAllMask"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames=""
    android:settingsActivity=".accessibility.GuardianAccessibilitySettings" />
