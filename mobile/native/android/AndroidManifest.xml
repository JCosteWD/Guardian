<?xml version="1.0" encoding="utf-8"?>
<!--
  GUARDIAN – AndroidManifest.xml (App Enfant)
  =============================================
  Toutes les permissions et déclarations nécessaires pour la sécurité complète.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.guardian.child">

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS RÉSEAU
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS VPN
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS OVERLAY (pour l'écran de blocage)
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS DEVICE ADMIN
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.BIND_DEVICE_ADMIN" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS DÉMARRAGE AUTOMATIQUE
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS NOTIFICATIONS (Android 13+)
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS USAGE STATS (pour surveiller les apps ouvertes)
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PERMISSIONS KEYSTORE (stockage sécurisé du token)
    ════════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="false">

        <!-- ── ACTIVITÉ PRINCIPALE ────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Déclare Guardian comme launcher home -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ── DEVICE ADMIN RECEIVER ─────────────────────────────────────── -->
        <!--
          Ce receiver permet à Guardian d'être administrateur de l'appareil.
          Une fois activé, l'enfant ne peut pas désinstaller l'app.
        -->
        <receiver
            android:name=".dpc.GuardianAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ── VPN SERVICE ───────────────────────────────────────────────── -->
        <!--
          Service VPN local pour filtrer le DNS.
          START_STICKY garantit le redémarrage automatique.
          Always-on VPN via MDM empêche la désactivation.
        -->
        <service
            android:name=".vpn.GuardianVPNService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="guardian_vpn_filter" />
        </service>

        <!-- ── ACCESSIBILITY SERVICE ─────────────────────────────────────── -->
        <!--
          Service qui surveille l'app au premier plan et affiche
          l'overlay de blocage. Ne peut pas être désactivé sans
          ouvrir les paramètres (que le DPC bloque aussi).
        -->
        <service
            android:name=".accessibility.GuardianAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label"
            android:description="@string/accessibility_service_description">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── BOOT RECEIVER ──────────────────────────────────────────────── -->
        <!--
          Démarre Guardian automatiquement au démarrage de l'appareil.
          L'enfant ne peut pas "éteindre" Guardian en redémarrant.
        -->
        <receiver
            android:name=".receivers.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ── FIREBASE MESSAGING ─────────────────────────────────────────── -->
        <service
            android:name=".notifications.GuardianMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── TAMPER DETECTION WORKER ────────────────────────────────────── -->
        <service
            android:name=".security.TamperNotificationWorker"
            android:exported="false" />

        <!-- ── CANAL DE NOTIFICATION ──────────────────────────────────────── -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="guardian_alerts" />

        <!-- Icône par défaut des notifications -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

    </application>

</manifest>
