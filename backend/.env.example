# ─── SERVER ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=Guardian

# ─── DATABASE (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guardian_db
DB_USER=guardian_user
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# ─── REDIS ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SESSION=86400

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_also_64_chars_minimum_change_this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── ENCRYPTION ───────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your_32_char_encryption_key_here
PIN_SALT_ROUNDS=12

# ─── ANTHROPIC AI ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-opus-4-5
AI_MAX_TOKENS=1024

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_FAMILY=price_family_monthly_id
STRIPE_PRICE_PREMIUM=price_premium_monthly_id

# ─── FIREBASE (Push notifications) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=guardian-app
FIREBASE_PRIVATE_KEY_ID=your_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@guardian-app.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# ─── SMTP (2FA emails) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=noreply@guardian-app.com

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ─── PLANS LIMITS ─────────────────────────────────────────────────────────────
FREE_MAX_CHILDREN=1
FAMILY_MAX_CHILDREN=3
PREMIUM_MAX_CHILDREN=999
